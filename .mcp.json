{
  "mcpServers": {
    "grafana": {
      "alwaysLoad": false,
      "type": "stdio",
      "command": "uvx",
      "args": ["mcp-grafana", "--disable-write"],
      "env": {
        "GRAFANA_URL": "https://grafana.${DOMAIN_PRIVATE}",
        "GRAFANA_SERVICE_ACCOUNT_TOKEN": "${GRAFANA_MCP_TOKEN}"
      }
    }
  }
}
